{
  "name": "taskuary",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ANALYTICS_STORE", "class_name": "StatsStore" }
    ]
  },
  "migrations": [
    { "tag": "stats-store-v1", "new_sqlite_classes": ["StatsStore"] }
  ]
}
