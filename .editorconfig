# Build inputs must reach vite with the SAME bytes on every machine. Vite preserves newlines inside
# JSX string attributes, so a CRLF working copy produces different chunk hashes from an LF one - and
# CI, which checks out LF, then rejects the committed bundle it cannot reproduce (build-web, red
# twice on 2026-09-14 before the cause was found). .gitattributes already normalises these on
# COMMIT; this is what stops an editor putting CRLF back on disk in between.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,mjs,json,css,html}]
end_of_line = lf

[*.py]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
